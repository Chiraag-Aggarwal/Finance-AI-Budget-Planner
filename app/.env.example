# Copy this file to app/.env for local use, then replace the URI placeholders.
# The app/.env file is ignored by Git; keep your real connection string private.
MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=finance_ai

# These settings are for local development over http://127.0.0.1.
FINANCE_AI_ENV=development
FINANCE_AI_COOKIE_SECURE=0
FINANCE_AI_HOST=127.0.0.1

# Email verification and password recovery (Gmail: use an App Password, not your normal password).
# Add these to your private app/.env file or deployment secret settings.
FINANCE_AI_PUBLIC_URL=http://127.0.0.1:8000
FINANCE_AI_SMTP_HOST=smtp.gmail.com
FINANCE_AI_SMTP_PORT=587
FINANCE_AI_SMTP_USERNAME=your-sender@gmail.com
FINANCE_AI_SMTP_PASSWORD=your-google-app-password
FINANCE_AI_SMTP_FROM=your-sender@gmail.com

# Render HTTPS API option (create a Brevo account and verify the sender email).
# FINANCE_AI_EMAIL_PROVIDER=brevo
# FINANCE_AI_BREVO_API_KEY=your-brevo-api-key
# FINANCE_AI_BREVO_SENDER=verified-sender@example.com
